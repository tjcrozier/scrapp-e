      <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
          <ros>
              <remapping>~/out:=/joint_states</remapping>
          </ros>
          <update_rate>5</update_rate>
        <joint_name>base_link_to_leftdrivewheel</joint_name>
        <joint_name>base_link_to_rightdrivewheel</joint_name>
        <joint_name>base_link_to_rightdrivewheel1</joint_name>
