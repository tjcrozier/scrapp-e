    <link name="cube3">
      <pose relative_to='base_link'>0 0 1.231873831439541 0 0 0</pose>
      <visual name='cube3 visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.75 0.75 0.75</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0.21586050010324417 0.05126945836711539 1</ambient>
          <diffuse>0 0.21586050010324417 0.05126945836711539 1</diffuse>
